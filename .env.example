FLASK_APP=app:create_app
SECRET_KEY=generare-con-python-c-"import secrets;print(secrets.token_hex(32))"
SESSION_COOKIE_SECURE=1
MAX_UPLOAD_MB=60

# Gruppo Zotero: l'ID numerico è nell'URL https://www.zotero.org/groups/<ID>/nome
ZOTERO_LIBRARY_ID=
ZOTERO_LIBRARY_TYPE=group
# Chiave API (zotero.org/settings/keys) con permesso di SCRITTURA sul gruppo:
# serve per salvare in Zotero le letture approvate. Controllo: flask zotero-verifica
ZOTERO_API_KEY=
ZOTERO_STYLE=chicago-author-date
ZOTERO_LOCALE=it-IT
ZOTERO_GROUP_URL=
ZOTERO_TAG_PROPOSTE=proposta-docenti
# Key della collezione di primo livello «Riferimenti di base» (nell'URL della collezione,
# .../collections/<KEY>): compare in fondo all'invito alla lettura di ogni edizione.
ZOTERO_COLLEZIONE_BASE=

# Email (SMTP Infomaniak). Vuoto MAIL_SERVER = le email non partono e finiscono nel log.
# Utente = indirizzo completo della casella; con la 2FA attiva usare una password per applicazione.
# Il mittente deve essere la casella stessa o un suo alias.
MAIL_SERVER=mail.infomaniak.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_MITTENTE=
# referenti avvisati a ogni candidatura inviata, separati da virgola
MAIL_NOTIFICHE=
# Ricerca dei libri (facoltativa): chiave API di Google Books (console.cloud.google.com,
# API "Books", gratuita). Vuota = senza chiave: Google risponde spesso 429 e ricerca dei libri e
# copertine restano a Open Library e (solo copertine) Amazon.
GOOGLE_BOOKS_API_KEY=
